{
  "routes": [
    {
      "route": "/api/{*rest}",
      "rewrite": "/api/proxy.js",
      "allowedRoles": ["anonymous"],
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
    },
    {
      "route": "/*",
      "serve": "/index.html"
    }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/index.html" }
  }
}
